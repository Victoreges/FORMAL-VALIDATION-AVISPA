role role_EV(EV,TA,CS:agent,
             H1,H2,H3,H4,DH:hash_func,
             P,TIDev,Cev,Nev,T1,T5,T13:text,
             PKev:public_key,
             SigEV:symmetric_key,
             SND,RCV:channel(dy))
played_by EV
def=
	local
		State:nat,
		Rev,Bevx,Ycs,ATIDevcs,Ac,IDta,Rta,T11,T15:text,
		PKta:public_key
	init
		State := 0
	transition
		1. State=0 /\ RCV(start) =|> State':=2
		/\ SND(H1(SigEV.TIDev.Cev.Nev.T1).T1)
		/\ SND({H2(PKev.Rev.TIDev).Rev.H3(H2(PKev.Rev.TIDev).Rev.T5).DH(P,Bevx)}_SigEV.T5)
		/\ secret(SigEV,sec_ev_ta,{EV,TA})
		/\ witness(EV,TA,auth_ev_ta,H1(SigEV.TIDev.Cev.Nev.T1))

		2. State=2 /\ RCV({IDta'.PKta'.Rta'.ATIDevcs'.Ac'.Ycs'}_SigEV.T11') =|> State':=3
		/\ SND(H4(H4(DH(Ycs',Bevx).ATIDevcs'.Ac').DH(P,Bevx).Ycs'.T13).T13)
		/\ secret(H4(DH(Ycs',Bevx).ATIDevcs'.Ac'),sec_sk,{EV,CS})
		/\ witness(EV,CS,auth_ev_cs,H4(H4(DH(Ycs',Bevx).ATIDevcs'.Ac').DH(P,Bevx).Ycs'.T13))

		3. State=3 /\ RCV(H4(H4(DH(Ycs',Bevx).ATIDevcs'.Ac').DH(P,Bevx).Ycs'.T15').T15') =|> State':=4
		/\ request(EV,CS,auth_cs_ev,H4(H4(DH(Ycs',Bevx).ATIDevcs'.Ac').DH(P,Bevx).Ycs'.T15'))

end role


role role_CS(CS,TA,EV:agent,
             H1,H2,H3,H4,DH:hash_func,
             P,TIDcs,Ccs,Ncs,T3,T7,T11,T15:text,
             PKcs:public_key,
             SigCS:symmetric_key,
             SND,RCV:channel(dy))
played_by CS
def=
	local
		State:nat,
		Rcs,CSy,E1,IDta,Rta,ATIDevcs,Ac,Bev,SigEVta,T5,T9,T13:text,
		PKta:public_key
	init
		State := 0
	transition
		1. State=0 /\ RCV(start) =|> State':=1
		/\ SND(H1(SigCS.TIDcs.Ccs.Ncs.T3).T3)
		/\ secret(SigCS,sec_cs_ta,{CS,TA})
		/\ witness(CS,TA,auth_cs_ta,H1(SigCS.TIDcs.Ccs.Ncs.T3))

		2. State=1 /\ RCV(E1'.T5') =|> State':=2
		/\ SND(E1'.{H2(PKcs.Rcs.TIDcs).Rcs.H3(H2(PKcs.Rcs.TIDcs).Rcs.T7).DH(P,CSy)}_SigCS.T7)

		3. State=2 /\ RCV({IDta'.PKta'.Rta'.ATIDevcs'.Ac'.Bev'.SigEVta'}_SigCS.T9') =|> State':=3
		/\ SND({IDta'.PKta'.Rta'.ATIDevcs'.Ac'.DH(P,CSy)}_SigEVta'.T11)
		/\ secret(H4(DH(Bev',CSy).ATIDevcs'.Ac'),sec_sk,{EV,CS})

		4. State=3 /\ RCV(H4(H4(DH(Bev',CSy).ATIDevcs'.Ac').Bev'.DH(P,CSy).T13').T13') =|> State':=4
		/\ SND(H4(H4(DH(Bev',CSy).ATIDevcs'.Ac').Bev'.DH(P,CSy).T15).T15)
		/\ request(CS,EV,auth_ev_cs,H4(H4(DH(Bev',CSy).ATIDevcs'.Ac').Bev'.DH(P,CSy).T13'))
		/\ witness(CS,EV,auth_cs_ev,H4(H4(DH(Bev',CSy).ATIDevcs'.Ac').Bev'.DH(P,CSy).T15))

end role


role role_TA(TA,EV,CS:agent,
             H1,H2,H3,H4,DH:hash_func,
             P,TIDev,Cev,Nev,TIDcs,Ccs,Ncs:text,
             PKev,PKcs:public_key,
             SigEV,SigCS:symmetric_key,
             IDta,Rta:text,
             PKta:public_key,
             SND,RCV:channel(dy))
played_by TA
def=
	local
		State:nat,
		T1,T3,T5,T7,T9:text,
		Rev,Rcs,Bev,Ycs,ATIDevcs,Ac:text
	init
		State := 0
	transition
		1. State=0 /\ RCV(H1(SigEV.TIDev.Cev.Nev.T1').T1') =|> State':=1
		/\ request(TA,EV,auth_ev_ta,H1(SigEV.TIDev.Cev.Nev.T1'))

		2. State=1 /\ RCV(H1(SigCS.TIDcs.Ccs.Ncs.T3').T3') =|> State':=2
		/\ request(TA,CS,auth_cs_ta,H1(SigCS.TIDcs.Ccs.Ncs.T3'))

		3. State=2 /\ RCV(
		     {H2(PKev.Rev'.TIDev).Rev'.H3(H2(PKev.Rev'.TIDev).Rev'.T5').Bev'}_SigEV.
		     {H2(PKcs.Rcs'.TIDcs).Rcs'.H3(H2(PKcs.Rcs'.TIDcs).Rcs'.T7').Ycs'}_SigCS.T7'
		   ) =|> State':=3
		/\ SND({IDta.PKta.Rta.ATIDevcs.Ac.Bev'.SigEV}_SigCS.T9)
		/\ secret(IDta,sec_9,{EV,CS,TA})
		/\ secret(Rta,sec_10,{EV,CS,TA})
		/\ secret(ATIDevcs,sec_11,{EV,CS,TA})
		/\ secret(Ac,sec_12,{EV,CS,TA})

end role


role session(EV,CS,TA:agent,
             H1,H2,H3,H4,DH:hash_func,
             P,TIDev,Cev,Nev,T1,T5,T13:text,
             TIDcs,Ccs,Ncs,T3,T7,T11,T15:text,
             IDta,Rta:text,
             PKev,PKcs,PKta:public_key,
             SigEV,SigCS:symmetric_key)
def=
	local
		SND1,RCV1,SND2,RCV2,SND3,RCV3:channel(dy)
	composition
		role_EV(EV,TA,CS,H1,H2,H3,H4,DH,P,
		        TIDev,Cev,Nev,T1,T5,T13,
		        PKev,SigEV,SND1,RCV1)
		/\
		role_CS(CS,TA,EV,H1,H2,H3,H4,DH,P,
		        TIDcs,Ccs,Ncs,T3,T7,T11,T15,
		        PKcs,SigCS,SND2,RCV2)
		/\
		role_TA(TA,EV,CS,H1,H2,H3,H4,DH,P,
		        TIDev,Cev,Nev,TIDcs,Ccs,Ncs,
		        PKev,PKcs,SigEV,SigCS,
		        IDta,Rta,PKta,SND3,RCV3)
end role


role environment()
def=
	const
		ev,cs,ta:agent,
		h1,h2,h3,h4,dh:hash_func,

		p,tidev,cev,nev,t1,t5,t13:text,
		tidcs,ccs,ncs,t3,t7,t11,t15:text,
		idta,rta:text,

		pkev,pkcs,pkta:public_key,
		sigev,sigcs:symmetric_key,

		sec_ev_ta,sec_cs_ta,sec_9,sec_10,sec_11,sec_12,sec_sk,
		auth_ev_ta,auth_cs_ta,auth_ev_cs,auth_cs_ev:protocol_id

	intruder_knowledge = {ev,cs,ta,h1,h2,h3,h4,dh,p,pkev,pkcs,pkta}

	composition
		session(ev,cs,ta,h1,h2,h3,h4,dh,
		        p,tidev,cev,nev,t1,t5,t13,
		        tidcs,ccs,ncs,t3,t7,t11,t15,
		        idta,rta,
		        pkev,pkcs,pkta,
		        sigev,sigcs)
end role


goal
	secrecy_of sec_ev_ta
	secrecy_of sec_cs_ta
	secrecy_of sec_9
	secrecy_of sec_10
	secrecy_of sec_11
	secrecy_of sec_12
	secrecy_of sec_sk
	authentication_on auth_ev_ta
	authentication_on auth_cs_ta
	authentication_on auth_ev_cs
	authentication_on auth_cs_ev

end goal

environment()
