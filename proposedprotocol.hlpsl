role role_EV(EV,CS,TA:agent,H2,H3,H4:hash_func,
             Rev,TIDev,TsEv:text,
             PKev:public_key,
             Sigev,Sigcs:symmetric_key,
             SND,RCV:channel(dy))
played_by EV
def=
	local
		State:nat,
		TsCs,IDta,Rta,ATIDevcs,Ac:text,
		PKta:public_key
	init
		State := 0

	transition

	1. State=0 /\ RCV(start) =|>
	   State' := 1
	   /\ SND({H2(PKev.Rev.TIDev).Rev.H3(H2(PKev.Rev.TIDev).Rev)}_Sigev.TsEv)
	   /\ secret(Rev,sec_rev,{EV,CS})
	   /\ secret(TIDev,sec_tidev,{EV,TA})
	   /\ witness(EV,CS,auth_ev_cs_req,Rev)

	2. State=1 /\ RCV({IDta'.PKta'.Rta'.ATIDevcs'.Ac'}_Sigev.TsCs') =|>
	   State' := 2
	   /\ request(EV,CS,auth_cs_ev_rta,Rta')
	   /\ SND({H4(IDta'.PKta'.Rta'.ATIDevcs')}_Sigev.TsEv)
	   /\ witness(EV,CS,auth_ev_cs_rta,Rta')

end role


role role_CS(CS,EV,TA:agent,H2,H3,H4:hash_func,
             Rcs,TIDcs,TsCs:text,
             PKcs:public_key,
             Sigev,Sigcs:symmetric_key,
             SND,RCV:channel(dy))
played_by CS
def=
	local
		State:nat,
		TsTa,TsEv,Rev,TIDev,IDta,Rta,ATIDevcs,Ac:text,
		PKev,PKta:public_key
	init
		State := 0

	transition

	1. State=0 /\ RCV({H2(PKev'.Rev'.TIDev').Rev'.H3(H2(PKev'.Rev'.TIDev').Rev')}_Sigev.TsEv') =|>
	   State' := 1
	   /\ request(CS,EV,auth_ev_cs_req,Rev')
	   /\ SND({H2(PKev'.Rev'.TIDev').Rev'.H3(H2(PKev'.Rev'.TIDev').Rev')}_Sigev.
	          {H2(PKcs.Rcs.TIDcs).Rcs.H3(H2(PKcs.Rcs.TIDcs).Rcs)}_Sigcs.TsCs)
	   /\ secret(Rcs,sec_rcs,{CS,TA})
	   /\ secret(TIDcs,sec_tidcs,{CS,TA})
	   /\ witness(CS,TA,auth_cs_ta_req,Rcs)

	2. State=1 /\ RCV({IDta'.PKta'.Rta'.ATIDevcs'.Ac'.Sigev}_Sigcs.TsTa') =|>
	   State' := 2
	   /\ request(CS,TA,auth_ta_cs_rta,Rta')
	   /\ SND({IDta'.PKta'.Rta'.ATIDevcs'.Ac'}_Sigev.TsCs)
	   /\ witness(CS,EV,auth_cs_ev_rta,Rta')

	3. State=2 /\ RCV({H4(IDta'.PKta'.Rta'.ATIDevcs')}_Sigev.TsEv') =|>
	   State' := 3
	   /\ request(CS,EV,auth_ev_cs_rta,Rta')
	   /\ SND({H4(IDta'.PKta'.Rta'.ATIDevcs')}_Sigev.
	          {H4(IDta'.PKta'.Rta'.ATIDevcs')}_Sigcs.TsCs)
	   /\ witness(CS,TA,auth_cs_ta_conf,ATIDevcs')

end role


role role_TA(TA,CS,EV:agent,H2,H3,H4:hash_func,
             ATIDevcs,Ac,IDta,Rta,TsTa:text,
             PKta:public_key,
             Sigev,Sigcs:symmetric_key,
             SND,RCV:channel(dy))
played_by TA
def=
	local
		State:nat,
		TsCs,Rev,TIDev,Rcs,TIDcs:text,
		PKev,PKcs:public_key
	init
		State := 0

	transition

	1. State=0 /\ RCV({H2(PKev'.Rev'.TIDev').Rev'.H3(H2(PKev'.Rev'.TIDev').Rev')}_Sigev.
	                  {H2(PKcs'.Rcs'.TIDcs').Rcs'.H3(H2(PKcs'.Rcs'.TIDcs').Rcs')}_Sigcs.TsCs') =|>
	   State' := 1
	   /\ request(TA,CS,auth_cs_ta_req,Rcs')
	   /\ SND({IDta.PKta.Rta.ATIDevcs.Ac.Sigev}_Sigcs.TsTa)
	   /\ secret(IDta,sec_idta,{EV,CS,TA})
	   /\ secret(Rta,sec_rta,{EV,CS,TA})
	   /\ secret(ATIDevcs,sec_atidevcs,{EV,CS,TA})
	   /\ secret(Ac,sec_ac,{EV,CS,TA})
	   /\ witness(TA,CS,auth_ta_cs_rta,Rta)

	2. State=1 /\ RCV({H4(IDta'.PKta'.Rta'.ATIDevcs')}_Sigev.
	                  {H4(IDta'.PKta'.Rta'.ATIDevcs')}_Sigcs.TsCs') =|>
	   State' := 2
	   /\ request(TA,CS,auth_cs_ta_conf,ATIDevcs')

end role


role session(EV,CS,TA:agent,H2,H3,H4:hash_func,
             Rev,TIDev,TsEv,
             Rcs,TIDcs,TsCs,
             ATIDevcs,Ac,IDta,Rta,TsTa:text,
             PKev,PKcs,PKta:public_key,
             Sigev,Sigcs:symmetric_key)
def=
	local
		SND1,RCV1,SND2,RCV2,SND3,RCV3:channel(dy)

	composition
		role_EV(EV,CS,TA,H2,H3,H4,
		        Rev,TIDev,TsEv,
		        PKev,Sigev,Sigcs,
		        SND1,RCV1)

	/\	role_CS(CS,EV,TA,H2,H3,H4,
		        Rcs,TIDcs,TsCs,
		        PKcs,Sigev,Sigcs,
		        SND2,RCV2)

	/\	role_TA(TA,CS,EV,H2,H3,H4,
		        ATIDevcs,Ac,IDta,Rta,TsTa,
		        PKta,Sigev,Sigcs,
		        SND3,RCV3)

end role


role environment()
def=
	const
		ev,cs,ta:agent,
		h2,h3,h4:hash_func,

		rev,tidev,tsev:text,
		rcs,tidcs,tscs:text,
		atidevcs,ac,idta,rta,tsta:text,

		pkev,pkcs,pkta:public_key,
		sigev,sigcs:symmetric_key,

		sec_rev,
		sec_tidev,
		sec_rcs,
		sec_tidcs,
		sec_idta,
		sec_rta,
		sec_atidevcs,
		sec_ac:protocol_id,

		auth_ev_cs_req,
		auth_cs_ta_req,
		auth_ta_cs_rta,
		auth_cs_ev_rta,
		auth_ev_cs_rta,
		auth_cs_ta_conf:protocol_id

	intruder_knowledge = {
		ev,cs,ta,
		h2,h3,h4,
		pkev,pkcs,pkta
	}

	composition
		session(ev,cs,ta,h2,h3,h4,
		        rev,tidev,tsev,
		        rcs,tidcs,tscs,
		        atidevcs,ac,idta,rta,tsta,
		        pkev,pkcs,pkta,
		        sigev,sigcs)

end role


goal
	secrecy_of sec_rev
	secrecy_of sec_tidev
	secrecy_of sec_rcs
	secrecy_of sec_tidcs
	secrecy_of sec_idta
	secrecy_of sec_rta
	secrecy_of sec_atidevcs
	secrecy_of sec_ac

	authentication_on auth_ev_cs_req
	authentication_on auth_cs_ta_req
	authentication_on auth_ta_cs_rta
	authentication_on auth_cs_ev_rta
	authentication_on auth_ev_cs_rta
	authentication_on auth_cs_ta_conf
end goal

environment()
